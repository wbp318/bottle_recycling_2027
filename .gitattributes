# Make every file type count toward the GitHub language bar.
# By default Linguist only counts "programming" and "markup" types and hides
# prose, data, and documentation. These overrides force everything detectable.

# ---- Global switches ----
*                       linguist-detectable=true
*                       linguist-documentation=false
*                       linguist-generated=false
*                       linguist-vendored=false

# ---- Markup ----
*.html    linguist-language=HTML         linguist-detectable=true
*.htm     linguist-language=HTML         linguist-detectable=true
*.xhtml   linguist-language=HTML         linguist-detectable=true
*.svg     linguist-language=SVG          linguist-detectable=true
*.xml     linguist-language=XML          linguist-detectable=true
*.xsl     linguist-language=XSLT         linguist-detectable=true

# ---- Prose / docs (normally hidden as documentation) ----
*.md       linguist-language=Markdown          linguist-detectable=true
*.markdown linguist-language=Markdown          linguist-detectable=true
*.rst      linguist-language=reStructuredText  linguist-detectable=true
*.txt      linguist-language=Text              linguist-detectable=true
*.adoc     linguist-language=AsciiDoc          linguist-detectable=true
*.org      linguist-language=Org               linguist-detectable=true
*.tex      linguist-language=TeX               linguist-detectable=true

# ---- Data / config (normally hidden as data) ----
*.json    linguist-language=JSON                  linguist-detectable=true
*.jsonc   linguist-language="JSON with Comments"  linguist-detectable=true
*.json5   linguist-language=JSON5                 linguist-detectable=true
*.yml     linguist-language=YAML                  linguist-detectable=true
*.yaml    linguist-language=YAML                  linguist-detectable=true
*.toml    linguist-language=TOML                  linguist-detectable=true
*.ini     linguist-language=INI                   linguist-detectable=true
*.cfg     linguist-language=INI                   linguist-detectable=true
*.env     linguist-language=Dotenv                linguist-detectable=true
*.csv     linguist-language=CSV                   linguist-detectable=true
*.tsv     linguist-language=TSV                   linguist-detectable=true
*.sql     linguist-language=SQL                   linguist-detectable=true
*.graphql linguist-language=GraphQL               linguist-detectable=true
*.proto   linguist-language="Protocol Buffer"     linguist-detectable=true
.gitignore     linguist-language="Ignore List"    linguist-detectable=true
.gitattributes linguist-language="Git Attributes" linguist-detectable=true
.editorconfig  linguist-language=EditorConfig     linguist-detectable=true

# ---- Styles ----
*.css     linguist-language=CSS   linguist-detectable=true
*.scss    linguist-language=SCSS  linguist-detectable=true
*.sass    linguist-language=Sass  linguist-detectable=true
